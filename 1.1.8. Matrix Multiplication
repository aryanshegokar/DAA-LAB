#include <stdio.h>

int main() {
    int m, n;
    

    if (scanf("%d %d", &m, &n) != 2) return 0;

    int A[m][n];
    for (int i = 0; i < m; i++) {
        for (int j = 0; j < n; j++) {
            scanf("%d", &A[i][j]);
        }
    }

    int rows_b, p;
    if (scanf("%d %d", &rows_b, &p) != 2) return 0;
    

    if (n != rows_b) {
        printf("Invalid input\n");
        return 0;
    }

    int B[rows_b][p];
    for (int i = 0; i < rows_b; i++) {
        for (int j = 0; j < p; j++) {
            scanf("%d", &B[i][j]);
        }
    }
    
    long long result[m][p];
    for (int i = 0; i < m; i++) {
        for (int j = 0; j < p; j++) {
            result[i][j] = 0;
            for (int k = 0; k < n; k++) {
                result[i][j] += (long long)A[i][k] * B[k][j];
            }
        }
    }
    

    for (int i = 0; i < m; i++) {
        for (int j = 0; j < p; j++) {
            printf("%lld ", result[i][j]);
        }
        printf("\n");
    }
    
    return 0;
}
