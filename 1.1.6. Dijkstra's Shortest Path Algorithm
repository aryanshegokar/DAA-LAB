#include <limits.h> 
#include <stdio.h>
#define MAX 20
int V, E;
int graph[MAX][MAX];
#define INFINITY 99999

void dijkstra(int G[MAX][MAX], int n, int startnode) {
    int dist[MAX], parent[MAX], visited[MAX];
    int i, j, min, minNode;

    for (i = 1; i <= n; i++) {
        dist[i] = INFINITY;
        visited[i] = 0;
        parent[i] = 0;
    }
    dist[startnode] = 0;

    for (i = 1; i <= n; i++) {
        min = INFINITY;
        minNode = -1;
        for (j = 1; j <= n; j++) {
            if (!visited[j] && dist[j] < min) {
                min = dist[j];
                minNode = j;
            }
        }
        if (minNode == -1) break;

        visited[minNode] = 1;

        for (j = 1; j <= n; j++) {
            if (!visited[j] && G[minNode][j] != 0 && dist[minNode] != INFINITY) {
                if (dist[minNode] + G[minNode][j] < dist[j]) {
                    dist[j] = dist[minNode] + G[minNode][j];
                    parent[j] = minNode;
                }
            }
        }
    }

    printf("Node\tDistance\tPath\n");
    for (i = 1; i <= n; i++) {
        if (i == startnode) continue;
        if (dist[i] == INFINITY) {
            printf("%4d\t%8s\tNO PATH\n", i, "INF");
        } else {
            printf("%4d\t%8d\t", i, dist[i]);
            int node = i;
            while (node != startnode) {
                printf("%d", node);
                node = parent[node];
                if (node != 0)
                    printf("<-");
            }
            printf("%d\n", startnode);
        }
    }

}
int main() { 
	int s, d, w, i, j;
	printf("Enter the number of vertices : ");
	scanf("%d", &V);
	printf("Enter the number of edges : ");
	scanf("%d", &E);
	for(i = 1 ; i <= V; i++) {
		for(j = 1; j <= V; j++) {
			graph[i][i] = 0;
		}
	}
	for(i = 1; i <= E; i++) {
		printf("Enter source : ");
		scanf("%d", &s);
		printf("Enter destination : ");
		scanf("%d", &d);
		printf("Enter weight : ");
		scanf("%d", &w);
		if(s > V || d > V || s <= 0 || d <= 0) {
			printf("Invalid index. Try again.\n");
			i--;
			continue;
		} else {
			graph[s][d] = w;
		}
	}
	printf("Enter the source :");
	scanf("%d", &s);
	dijkstra(graph, V, s); 
	return 0; 
} 
